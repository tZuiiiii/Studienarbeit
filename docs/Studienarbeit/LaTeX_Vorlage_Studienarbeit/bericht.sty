% Definitionen mit Ausgabe im Index
% gibt #2 aus und fügt #1 bzw. #2 (wenn #1 nicht angegeben) in den Index ein
\newcommand{\Def}[2][]{%
   \def\OPTARG{#1}%
   \def\EMPTY{}%
   \ifx\OPTARG\EMPTY\index{#2}\else\index{#1}\fi%
   \textbf{#2}\xspace%
}

% Entfernen von ISBN, DOI und Zugriffsdatum
\AtEveryBibitem{%
  \clearfield{isbn}%
  \clearfield{doi}%
  %\clearfield{url}%
  \clearfield{urldate}%
}
\renewbibmacro*{publisher+location+date}{%
  \printnames{author}% Ausgabe der Autoren
  \setunit{\addcolon\space}% Doppelpunkt und Leerzeichen hinter Autoren
  \printfield{title},%
  \newunit\newblock
  \printlist{publisher}%
  % Komma nach Publisher, wenn edition oder annotation existieren
  \iffieldundef{edition}{%
    \iffieldundef{annotation}{%
      \addcomma % beide fehlen → trotzdem Komma vor Jahr
    }{%
      \addcomma\space\printfield{annotation}%
    }%
  }{%
    \addcomma\space\printfield{edition}%
    \iffieldundef{annotation}{}{%
      \addcomma\space\printfield{annotation}%
    }%
  }%
  \space\printfield{year}%
}


\DeclareBibliographyDriver{book}{%
  \usebibmacro{publisher+location+date}%
  \finentry
}
\DeclareFieldFormat{url}{\url{#1}}

\renewbibmacro*{links}{
  \printnames{author}
  \setunit{\addcolon\space}
  \printfield{title},
  \printfield{url}
  \iffieldundef{year}{
    \addcomma\space o.J.,
  }{
    \addcomma\space\printfield{year},
  }
  Einsichtnahme: \printfield{annotation}
  \newunit\newblock
}
\DeclareBibliographyDriver{misc}{
  \usebibmacro{links}
  \finentry
}
\renewbibmacro*{dissertation}{
  \printfield{author}
  \setunit{\addcolon\space}
  \printfield{title},
  Diss.,
  \printfield{school}
  \printfield{year}
}
\DeclareBibliographyDriver{phdthesis}{
  \usebibmacro{dissertation}
  \finentry
}
\defbibheading{bibliography}{\chapter*{Literaturverzeichnis}}
\defbibheading{internet}{\chapter*{Liste der Internetquellen}}
