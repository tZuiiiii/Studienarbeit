<?xml version="1.0"?>
<launch>
    <arg name="camera_topic" default="/pylon_camera_node/image_raw" />
    <arg name="show_viz" default="true" />

    <include file="$(find pylon_camera)/launch/pylon_camera_node.launch" />

    <node name="mood_detection_node" pkg="common" type="mood_industry_camera.py" output="screen">
        <param name="image_topic" value="$(arg camera_topic)" />
        <param name="visualize" value="$(arg show_viz)" />
    </node>
</launch>